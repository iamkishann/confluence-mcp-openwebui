# Open WebUI + MCP Atlassian example for Jira Data Center and Confluence Data Center.
# Copy to .env.open-webui.dc and replace placeholder values.

# Serve MCP Atlassian over native MCP Streamable HTTP for Open WebUI.
TRANSPORT=streamable-http
HOST=0.0.0.0
PORT=8000

# Start read-only until you are comfortable enabling write operations.
READ_ONLY_MODE=true

# Limit the exposed tool surface to the most common Jira + Confluence workflows.
TOOLSETS=jira_issues,jira_fields,confluence_pages,confluence_comments,confluence_attachments

# Jira Data Center
JIRA_URL=https://jira.your-company.internal
JIRA_PERSONAL_TOKEN=replace-with-your-jira-pat
# Uncomment only if your Jira DC certificate is not trusted by the container.
# JIRA_SSL_VERIFY=false

# Confluence Data Center
CONFLUENCE_URL=https://confluence.your-company.internal
CONFLUENCE_PERSONAL_TOKEN=replace-with-your-confluence-pat
# Uncomment only if your Confluence DC certificate is not trusted by the container.
# CONFLUENCE_SSL_VERIFY=false

# Optional scope filters
# JIRA_PROJECTS_FILTER=PROJ,SUPPORT
# CONFLUENCE_SPACES_FILTER=ENG,OPS

# Optional logging while you validate the integration
MCP_VERY_VERBOSE=true
# MCP_LOGGING_STDOUT=true